{
  "files.exclude": {
    "vite.config.ts": false,
    "vercel.json": false,
    "test-vercel-build.sh": false,
    "tsconfig.json": false,
    "tailwind.config.ts": false,
    "screenshot.png": false,
    "README copy.md": false,
    "postcss.config.js": false,
    "package-lock.json": false,
    "LICENSE": false,
    "drizzle.config.ts": false,
    "components.json": false,
    "build.sh": false,
    ".vercelignore": false,
    ".gitlab-ci.yml": false,
    "node_modules": false,
    "temp": false
  },
  "chat.tools.terminal.autoApprove": {
    "npm ls": true,
    "npm uninstall": true,
    "timeout": true,
    "/^node -e \"require\\('@playwright/test'\\); console\\.log\\('PW-OK'\\)\"$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^node -e \"console\\.log\\(Object\\.keys\\(require\\('@playwright/test'\\)\\)\\);\"$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^node scripts/screenshot\\.js$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^node scripts/screenshot\\.cjs$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "mkdir": true,
    "git add": true,
    "git commit": true,
    "git push": true,
    "git mv": true,
    "/^python3 --version$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "git checkout": true,
    "killall": true,
    "pgrep": true,
    "reset": true,
    "mv": true,
    "docker-compose": true,
    "docker rmi": true,
    "docker ps": true,
    "docker rm": true,
    "docker image": true,
    "docker logs": true
  },
}
