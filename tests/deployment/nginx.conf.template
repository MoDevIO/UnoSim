map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    server_name _;

    ssl_certificate /etc/nginx/tls/test.crt;
    ssl_certificate_key /etc/nginx/tls/test.key;

    location / {
        proxy_pass http://172.30.0.10:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;

        # The gateway owns these identity headers. Client-supplied values are
        # overwritten before a request reaches the production backend.
        proxy_set_header X-UnoSim-Gateway-Secret "__RUNTIME_GATEWAY_SECRET__";
        proxy_set_header X-UnoSim-Subject "deployment-test-user";
        proxy_set_header X-UnoSim-Roles "user";

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 120s;
    }
}
