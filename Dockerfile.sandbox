# Minimal sandbox image for Arduino sketch execution
# The backend spawns this image with a mounted /sandbox sketch directory.
FROM debian:stable-slim

# Install build tools and prepare filesystem
RUN apt-get update \
    && apt-get install -y --no-install-recommends g++ ca-certificates \
    && useradd -m -u 1000 -s /bin/bash sandboxuser \
    && mkdir -p /sandbox /tmp \
    && chown -R sandboxuser:sandboxuser /sandbox /tmp \
    && chmod 755 /sandbox /tmp \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /sandbox

# Switch to non-root user (UID 1000)
USER sandboxuser
