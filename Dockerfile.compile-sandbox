# Compile sandbox (plan P2.4): one short-lived container per compile in the Docker profile.
# The backend starts it with no network, a read-only root filesystem, the sketch as its only
# (read-only) bind mount and a bounded tmpfs; see server/services/compiler/sandboxed-cli-runner.ts.
# Build: npm run build:compile-sandbox

# Library packages of shared/library-catalog.json (SSOT Libraries §10): downloaded and checked
# against the catalog SHA-256 at image build time; a compile never downloads anything.
FROM node:24.20.0-slim AS libraries
RUN apt-get update && apt-get install -y --no-install-recommends unzip ca-certificates && rm -rf /var/lib/apt/lists/*
COPY shared/library-catalog.json /work/shared/library-catalog.json
COPY scripts/provision-libraries.mjs /work/scripts/provision-libraries.mjs
RUN node /work/scripts/provision-libraries.mjs --root /opt/unosim/libraries --catalog /work/shared/library-catalog.json

FROM debian:bookworm-slim
ARG DEBIAN_FRONTEND=noninteractive
COPY scripts/install-arduino-cli.sh scripts/arduino-avr-core-version scripts/check-arduino-avr-core-version.sh scripts/install-arduino-avr-core.sh \
     scripts/attinycore-version scripts/check-attinycore-version.sh scripts/install-attinycore.sh /usr/local/bin/
# curl only fetches the pinned CLI and cores; it does not stay in the image.
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates tar xz-utils bzip2 \
    && sh /usr/local/bin/install-arduino-cli.sh \
    && arduino-cli version | grep -F "Version: 1.5.1 " \
    && useradd -m -u 1000 -s /usr/sbin/nologin compile \
    && su compile -s /bin/sh -c 'arduino-cli config init' \
    && su compile -s /bin/sh -c 'sh /usr/local/bin/install-arduino-avr-core.sh' \
    && su compile -s /bin/sh -c 'sh /usr/local/bin/install-attinycore.sh' \
    && rm /usr/local/bin/install-arduino-cli.sh /usr/local/bin/install-arduino-avr-core.sh /usr/local/bin/install-attinycore.sh \
    && apt-get purge -y curl bzip2 && apt-get autoremove -y && apt-get clean && rm -rf /var/lib/apt/lists/*
COPY --chmod=755 scripts/compile-sandbox-entry.sh /usr/local/bin/unosim-compile
# Read-only for the compile user; the sketchbook installs no library, so only these packages exist.
COPY --from=libraries /opt/unosim/libraries /opt/unosim/libraries
RUN test ! -e /home/compile/Arduino/libraries && test ! -e /home/compile/.arduino15/libraries \
    && test -s /opt/unosim/libraries/provided.json
USER compile
WORKDIR /home/compile
# Precompile the core of every catalog board (shared/boards.ts).
# arduino-cli 1.5.1 archives a core under build_cache.path only for builds without --build-path;
# the sketch part of that cache is dropped again (spike P0.2).
RUN mkdir -p /home/compile/warm \
    && printf '%s\n' 'void setup(){Serial.begin(9600);pinMode(13,OUTPUT);analogWrite(3,1);analogRead(A0);}' \
       'void loop(){digitalWrite(13,!digitalRead(13));delay(10);Serial.println(millis());}' > /home/compile/warm/warm.ino \
    && for fqbn in arduino:avr:uno arduino:avr:nano:cpu=atmega328 arduino:avr:mega:cpu=atmega2560 \
                   ATTinyCore:avr:attinyx5:chip=85,clock=8internal; do \
         arduino-cli compile --fqbn "$fqbn" /home/compile/warm >/dev/null || exit 1; \
       done \
    && rm -rf /home/compile/warm /home/compile/.cache/arduino/sketches \
    && test -n "$(ls /home/compile/.cache/arduino/cores)"
