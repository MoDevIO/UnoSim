##################################
# 1. SYSTEM & LOGS               #
##################################
.DS_Store
Thumbs.db
*.bak
*.swp
*~
*.log
npm-debug.log*
.zshrc.local
yarn-debug.log*
yarn-error.log*

##################################
# 2. DEPENDENCIES                #
##################################
/node_modules/
/vendor/
.venv/
/venv/

##################################
# 3. BUILD & ARTIFACTS           #
##################################
# Production builds
/dist/
/build/
/target/

# Local/Temp caches
/storage/cache/
.cache/
.vite/
.next/
/coverage/
.coverage-run-start.json
*.tsbuildinfo

# Arduino Compiler Cache (Binaries & Build-Artifacts)
server/arduino-cache/
storage/binaries/

# Project specific temp folders (runtime artifacts)
/temp/*
!/temp/.gitkeep
/cache/
/test-results/
/playwright-report/
# /screenshots/
.scannerwork/
.scannerwork/*
/scannerwork/

# Generated load-test measurements
/load-test-results/*-client-observability-*.json
/load-test-results/*-client-simulation-observability-*.json

# Old archive folder (legacy, use /docs/archive instead)
/archive/

##################################
# 4. COMPILER & TYPESCRIPT       #
##################################
# Ignore compiled JS only in source directories (not in root configs)
client/src/**/*.js
server/**/*.js
shared/**/*.js
!**/*.config.js
!**/eslint.config.js
!**/vite.config.js

##################################
# 5. ENVIRONMENT & SECURITY      #
##################################
.env
.env*.local
.vercel
.vscode/settings.json

##################################
# 6. STORAGE & DB (SIMULATION)   #
##################################
*.sqlite
*.db
/storage/*.json
!/storage/.gitkeep
/storage/core-cache/meta/*.ready

##################################
# 7. DOCUMENTATION & REPORTS     #
##################################
# Temporary one-off reports are archived in /docs/archive/
# Binary reports and benchmarks should not be committed
*.csv
font_size_report_*.md
benchmark-*.json
# but keep /docs/archive tracked since it contains organized archives

server/arduino-cache/
